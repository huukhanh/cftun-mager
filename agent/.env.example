# Copy to .env and edit before running `docker compose up -d`.

# Required: the Worker URL this agent talks to. Same one you pass install.sh.
MAGER_WORKER_URL=https://your-worker.workers.dev

# Optional: name shown in the dashboard. Defaults to the container hostname.
# MAGER_MACHINE_NAME=living-room-pi

# Optional: pin to a specific published image tag.
# See https://github.com/huukhanh/pub-pkg/pkgs/container/mager-agent for tags.
# MAGER_IMAGE_TAG=latest
